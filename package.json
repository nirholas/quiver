{
  "name": "quiver",
  "version": "0.1.0",
  "private": true,
  "description": "Quiver: intent-based swap aggregation for Robinhood Chain. Users sign what they want, solvers compete on how, the contract enforces the limit.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "@hono/node-server@>=1.19.10 <2.1.3": "^2.1.3",
      "vite@>=7.0.0 <=7.3.6": "^7.3.7",
      "@vitest/mocker@>=2.1.0-beta.7.0.0 <4.1.12": "^4.1.12",
      "@vitest/mocker@>=2.1.0 <4.1.11": "^4.1.12",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "tinypool@<=2.1.0": "^2.1.2",
      "tinypool@<2.1.2": "^2.1.2",
      "vitest@>=2.1.0 <4.1.11": "^4.1.11"
    }
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build && pnpm -r --filter './apps/*' run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "api": "pnpm --filter @quiverdex/api start",
    "solver": "pnpm --filter @quiverdex/solver start",
    "web": "pnpm --filter @quiverdex/web dev"
  }
}
